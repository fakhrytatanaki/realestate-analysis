{
  "_comment": "Hand-written templates in the shape rule induction must produce. They prove the template language can express every archived generation of the site; they are test data, not seeds.",
  "vocab": {
    "listing_type": [
      {"pattern": "for[- ]rent|rental|للايجار|للإيجار|ايجار|إيجار", "value": "RENT"},
      {"pattern": "for[- ]sale|للبيع|بيع", "value": "SALE"}
    ],
    "property_type": [
      {"pattern": "villa|فيلا|فيلل", "value": "VILLA"},
      {"pattern": "duplex|دوبلكس", "value": "APARTMENT"},
      {"pattern": "apartment|flat|شقة|شقق|شقه", "value": "APARTMENT"},
      {"pattern": "\\bland\\b|ارض|أرض", "value": "LAND"},
      {"pattern": "office|مكتب|اداري", "value": "OFFICE"},
      {"pattern": "shop|store|محل|تجاري", "value": "SHOP"}
    ]
  },
  "a1_2011_list": {
    "condition": {"type": "all", "conditions": [
      {"type": "dom_css", "css": "ul#the-list > li div.c-2 h3 a", "min": 3}]},
    "template": {
      "page_kind": "LIST",
      "items": {"css": "ul#the-list > li"},
      "fields": {
        "title": [{"css": ".c-2 h3 a"}],
        "url": [{"css": ".c-2 h3 a", "attr": "href"}],
        "external_id": [{"css": ".c-2 h3 a", "attr": "href", "regex": "(iid-\\d+)"}],
        "price": [{"css": ".c-3"}],
        "category": [{"css": ".c-2 p span a"}],
        "location": [{"css": ".c-2 p span a", "regex": "-\\s*([^-]+)$"}],
        "listed_at": [{"css": ".c-2 p span"}],
        "description": [{"css": ".c-2 p"}]
      },
      "links": [{"css": "a[href*='-p-']", "rel": "PAGINATION"}]
    }
  },
  "a2_2013_list": {
    "condition": {"type": "dom_css", "css": "div#the-list > div.li h3 a", "min": 3},
    "template": {
      "page_kind": "LIST",
      "items": {"css": "div#the-list > div.li"},
      "fields": {
        "title": [{"css": "h3 a"}],
        "url": [{"css": "h3 a", "attr": "href"}],
        "external_id": [{"css": "h3 a", "attr": "href", "regex": "(iid-\\d+)"}],
        "price": [{"css": ".third-column-container"}, {"css": "h3 a", "regex": "(\\d[\\d,.]*\\s*(?:GBP|EGP|USD))"}],
        "category": [{"css": ".itemlistinginfo a"}],
        "location": [{"css": ".itemlistinginfo a", "regex": "Sale\\s*-\\s*(.+)$|Rent\\s*-\\s*(.+)$"}],
        "listed_at": [{"css": ".fourth-column-container"}],
        "bedrooms": [{"css": ".c-4", "regex": "Bedrooms:\\s*(\\d+)"}, {"css": ".second-column-container", "regex": "Bedrooms:\\s*(\\d+)"}]
      },
      "links": [{"css": "a.ui-next", "rel": "PAGINATION"}]
    }
  },
  "a2_2013_detail": {
    "condition": {"type": "all", "conditions": [
      {"type": "url_regex", "pattern": "-iid-\\d+"},
      {"type": "text_regex", "pattern": "Ad details"}]},
    "template": {
      "page_kind": "DETAIL",
      "items": null,
      "fields": {
        "title": [{"css": "h1", "scope": "page"}, {"css": "title", "scope": "page", "regex": "^(.*?) - "}],
        "external_id": [{"script": "xtcustom", "json": "ad_id"}],
        "category": [{"css": "title", "scope": "page"}],
        "bathrooms": [{"css": "body", "scope": "page", "regex": "Bathrooms:\\s*(\\d+)"}],
        "bedrooms": [{"css": "body", "scope": "page", "regex": "Bedrooms:\\s*(\\d+)"}]
      }
    }
  },
  "b_2015_list": {
    "condition": {"type": "dom_css", "css": "div.d-listing__item a.d-listing__name", "min": 3},
    "template": {
      "page_kind": "LIST",
      "items": {"css": "div.d-listing__item"},
      "fields": {
        "title": [{"css": "a.d-listing__name"}],
        "url": [{"css": "a.d-listing__name", "attr": "href"}],
        "external_id": [{"css": "a.d-listing__name", "attr": "href", "regex": "listing/([^/]+)/show"}],
        "price": [{"css": ".d-listing__amount"}],
        "area": [{"css": ".d-listing__cat .value", "index": 0}],
        "bedrooms": [{"css": ".d-listing__cat .value", "index": 1}],
        "category": [{"const": "property-for-sale"}]
      },
      "default_currency": "EGP"
    }
  },
  "c_2019_list": {
    "condition": {"type": "dom_css", "css": "li.item[data-ad-id]", "min": 3},
    "template": {
      "page_kind": "LIST",
      "items": {"css": "li.item[data-ad-id]"},
      "fields": {
        "title": [{"css": ".title"}],
        "url": [{"css": "a.adLink", "attr": "href"}],
        "external_id": [{"attr": "data-ad-id"}],
        "price": [{"css": ".price"}, {"attr": "data-ninja", "decode": "urlencoded_json", "json": "itemPrice"}],
        "category": [{"attr": "data-ninja", "decode": "urlencoded_json", "json": "categoryLevel3Name"}],
        "location": [{"attr": "data-ninja", "decode": "urlencoded_json", "json": "cityName"}],
        "listed_at": [{"attr": "data-ninja", "decode": "urlencoded_json", "json": "creationDate"}],
        "extra.seller_type": [{"attr": "data-ninja", "decode": "urlencoded_json", "json": "sellerType"}]
      },
      "default_currency": "EGP"
    }
  },
  "c_2021_list": {
    "condition": {"type": "dom_css", "css": "div.ads__item a.ads__item__ad--title", "min": 3},
    "template": {
      "page_kind": "LIST",
      "items": {"css": "div.ads__item"},
      "fields": {
        "title": [{"css": "a.ads__item__ad--title"}],
        "url": [{"css": "a.ads__item__ad--title", "attr": "href"}],
        "external_id": [{"css": "a.ads__item__ad--title", "attr": "href", "regex": "-ID([A-Za-z0-9]+)\\.html"}],
        "price": [{"css": ".ads__item__price"}],
        "category": [{"css": ".ads__item__breadcrumbs"}],
        "location": [{"css": ".ads__item__location"}],
        "listed_at": [{"css": ".ads__item__date"}]
      },
      "default_currency": "EGP"
    }
  },
  "d_2023_list": {
    "condition": {"type": "json_path", "script": "state", "path": "algolia.content.hits", "min": 3},
    "template": {
      "page_kind": "LIST",
      "items": {"script": "state", "path": "algolia.content.hits"},
      "fields": {
        "title": [{"json": "title"}],
        "external_id": [{"json": "externalID"}],
        "url": [{"template": "/ad/{slug}-ID{externalID}.html"}],
        "price": [{"json": "extraFields.price"}, {"json": "price"}],
        "location": [{"json": "location.lvl2.name_l1"}, {"json": "location.lvl1.name_l1"}],
        "listed_at": [{"json": "createdAt"}],
        "bedrooms": [{"json": "extraFields.rooms"}],
        "bathrooms": [{"json": "extraFields.baths"}],
        "area": [{"json": "extraFields.ft"}],
        "category": [{"json": "category.lvl1.name"}, {"script": "state", "json": "router.location.pathname"}]
      },
      "default_currency": "EGP"
    }
  },
  "c_2019_detail_other": {
    "condition": {"type": "text_regex", "pattern": "Industrial Equipment|Ad archived"},
    "template": {"page_kind": "OTHER"}
  }
}
